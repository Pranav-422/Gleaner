# Copy to backend/.env (git-ignored) and fill in. Never commit the real file.

# Sorting and structuring. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Free-tier model; change if Google retires it.
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional. Your goals, used for the worth-it score's "relevance" part.
# GLEANER_GOALS=Get an AI engineering job, win hackathons, start a faceless YouTube channel
# Optional. 1 = also verify claims with Google Search grounding. Not in the free tier (429 without billing).
# GEMINI_SEARCH=1

# Speech to text. https://console.groq.com/keys  (leave empty to skip speech)
GROQ_API_KEY=

# Cloud relay (Supabase). Project Settings > API: project URL and the anon/public key.
# Never put the service_role key here or anywhere else in Gleaner.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# The one user you created in Supabase Auth. The laptop signs in as you, so row level security applies.
SUPABASE_EMAIL=
SUPABASE_PASSWORD=

# Login for the local API on this laptop. Generate with:  uv run python -m app.auth
GLEANER_PASSWORD_HASH=

# Google Calendar + Tasks (optional until you want reminders). See README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/google/callback
# GLEANER_TZ=Asia/Kolkata
